    \"\\n\",","    \"- Example2:\\n\",","    \"Input: [2,2,1,1,1,2,2] Output: 2\"","   ]","  },","  {","   \"cell_type\": \"code\",","   \"execution_count\": null,","   \"id\": \"ceac113b-0b6f-4e88-9df5-3d37c7100d5a\",","   \"metadata\": {},","   \"outputs\": [],","   \"source\": []","  },","  {","   \"cell_type\": \"markdown\",","   \"id\": \"e54d849f-ac86-494c-9c43-43ee6a99590c\",","   \"metadata\": {},","   \"source\": [","    \"# Leetcode 167. Two Sum II - Input array is sorted\\n\",","    \"\\n\",","    \"Description:\\n\",","    \"Given an array of integers that is already sorted in ascending order, \\n\",","    \"find two numbers such that they add up to a specific target number.\\n\",","    \"\\n\",","    \"The function twoSum should return indices of the two numbers such that they add up to the target, \\n\",","    \"where index1 must be less than index2.\\n\",","    \"\\n\",","    \"Note:\\n\",","    \"Your returned answers (both index1 and index2) are not zero-based.\\n\",","    \"You may assume that each input would have exactly one solution and you may not use the same element twice.\\n\",","    \"\\n\",","    \"- Example:\\n\",","    \"Input: numbers = [2,7,11,15], target = 9, Output: [1,2]\\n\",","    \"\\n\",","    \"Explanation: The sum of 2 and 7 is 9. Therefore index1 = 1, index2 = 2.\\n\"","   ]","  },","  {","   \"cell_type\": \"code\",","   \"execution_count\": 96,","   \"id\": \"22f8a1fc-1f98-43ae-ab9c-7bb5bd22dcdc\",","   \"metadata\": {},","   \"outputs\": [],","   \"source\": [","    \"def twoSumII(nlist, target):\\n\",","    \"    for i in range(len(nlist)):\\n\",","    \"        index = binarySearch(nlist, target-nlist[i], i+1)\\n\",","    \"        if index != -1:\\n\",","    \"            return [i+1, index+1]\\n\",","    \"\\n\",","    \"def binarySearch(nlist, num, start):\\n\",","    \"    left, right = start, len(nlist)-1\\n\",","    \"    while left \u003c= right:\\n\",","    \"        mid = (left+right) // 2\\n\",","    \"        if nlist[mid] == num:\\n\",","    \"            return mid\\n\",","    \"        elif nlist[mid] \u003e num:\\n\",","    \"            right = mid -1\\n\",","    \"        else:\\n\",","    \"            left = mid + 1\\n\",","    \"    return -1\\n\",","    \"    \"","   ]","  },","  {","   \"cell_type\": \"code\",","   \"execution_count\": 97,","   \"id\": \"fa3af2fe-a058-450d-bd18-a7d281a0f46b\",","   \"metadata\": {},","   \"outputs\": [","    {","     \"data\": {","      \"text/plain\": [","       \"[1, 2]\"","      ]","     },","     \"execution_count\": 97,","     \"metadata\": {},","     \"output_type\": \"execute_result\"","    }","   ],","   \"source\": [","    \"twoSumII([2,7,11,15], 9)\"","   ]","  },","  {","   \"cell_type\": \"code\",","   \"execution_count\": 98,","   \"id\": \"89ea1d12-02b9-40bc-96a7-0e34d659698a\",","   \"metadata\": {},","   \"outputs\": [","    {","     \"data\": {","      \"text/plain\": [","       \"[2, 4]\"","      ]","     },","     \"execution_count\": 98,","     \"metadata\": {},","     \"output_type\": \"execute_result\"","    }","   ],","   \"source\": [","    \"twoSumII([1, 3, 4, 7, 11], 10)\"","   ]","  },","  {","   \"cell_type\": \"code\",","   \"execution_count\": null,","   \"id\": \"9acfc44d-cdf9-4d60-a704-b59a9cb7dcb9\",","   \"metadata\": {},","   \"outputs\": [],","   \"source\": []","  },","  {","   \"cell_type\": \"code\",","   \"execution_count\": null,","   \"id\": \"5253bec9-51bf-4945-b5d6-682780fc99c3\",","   \"metadata\": {},","   \"outputs\": [],","   \"source\": []","  },","  {","   \"cell_type\": \"code\",","   \"execution_count\": null,","   \"id\": \"27994065-f7c1-4ad5-bde6-42a1289349c6\",","   \"metadata\": {},","   \"outputs\": [],","   \"source\": []","  },","  {","   \"cell_type\": \"code\",","   \"execution_count\": null,","   \"id\": \"a7d07709-3658-4d57-8c2d-c768bc9f7b4e\",","   \"metadata\": {},","   \"outputs\": [],","   \"source\": []","  },","  {","   \"cell_type\": \"code\",","   \"executi